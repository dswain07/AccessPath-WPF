<Window x:Class="AccessPath.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        Title="AccessPath"
        Height="720"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"

        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             APPLICATION HEADER
             ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- Application Identity -->

            <StackPanel Grid.Column="0">

                <TextBlock Text="ACCESSPATH"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock Text="UofSC Campus Accessibility and Route Management"
                           FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Margin="0,4,0,0"/>

            </StackPanel>


            <!-- Application Label -->

            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,7"
                    VerticalAlignment="Center">

                <TextBlock Text="Campus Management"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}"/>

            </Border>

        </Grid>


        <!-- =====================================================
             NAVIGATION
             ===================================================== -->

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,18">

            <StackPanel Orientation="Horizontal">

                <Button Content="Buildings"
                        Width="110"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="BuildingsButton_Click"/>

                <Button Content="Manage Routes"
                        Width="135"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="RoutesButton_Click"/>

                <Button Content="Accessibility"
                        Width="135"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="AccessibilityButton_Click"/>

                <Button Content="Administration"
                        Width="135"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="AdminButton_Click"/>

                <Button Content="Settings"
                        Width="110"
                        Height="36"
                        Click="SettingsButton_Click"/>

            </StackPanel>

        </Border>


        <!-- =====================================================
             CURRENT PAGE
             ===================================================== -->

        <ContentControl x:Name="MainContent"
                        Grid.Row="2"/>

    </Grid>

</Window>
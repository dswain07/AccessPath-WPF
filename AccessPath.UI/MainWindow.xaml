<Window x:Class="AccessPath.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccessPath.UI"
        mc:Ignorable="d"
        Title="AccessPath" Height="600" Width="1000" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">

            <TextBox x:Name="SearchTextBox"
                     Width="300"
                     Height="30"
                     Margin="0,0,10,0"/>

            <Button x:Name="SearchButton"
                    Content="Search"
                    Width="100"
                    Height="30"
                    Click="SearchButton_Click"/>

            <Button x:Name="RoutesButton"
                    Content="Manage Routes"
                    Width="120"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="RoutesButton_Click"/>

            <Button x:Name="AccessibilityButton"
                    Content="Accessibility"
                    Width="120"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="AccessibilityButton_Click"/>

            <Button x:Name="AdminButton"
                    Content="Administration"
                    Width="120"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="AdminButton_Click"/>

            <Button x:Name="SettingsButton"
                    Content="Settings"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Click="SettingsButton_Click"/>


        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="0,0,0,15">

            <TextBlock Text="Add Building"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            
            <!-- Inputs Here-->

            <TextBlock Text="Building Name"/>
            <TextBox x:Name="BuildingNameTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Building Type"/>
            <TextBox x:Name="BuildingTypeTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Opening Hours"/>
            <TextBox x:Name="OpeningHoursTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Closing Hours"/>
            <TextBox x:Name="ClosingHoursTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Latitude"/>
            <TextBox x:Name="LatitudeTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Longitude"/>
            <TextBox x:Name="LongitudeTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Address ID"/>
            <TextBox x:Name="AddressIDTextBox"
                     Width="250"
                     Margin="0,5"
                     HorizontalAlignment="Left"/>

            <Button x:Name="AddBuildingButton"
                    Content="Add Building"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,10"
                    Click="AddBuildingButton_Click"/>

            <Button x:Name="UpdateBuildingButton"
                    Content="Update Building"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,10"
                    Click="UpdateBuildingButton_Click"/>

            <Button x:Name="DeleteBuildingButton"
                    Content="Delete Building"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,10"
                    Click="DeleteBuildingButton_Click"/>

        </StackPanel>

        <DataGrid x:Name="BuildingDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="BuildingDataGrid_SelectionChanged"/>


    </Grid>
</Window>

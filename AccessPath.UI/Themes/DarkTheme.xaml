<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush"
                     Color="#1E1E1E"/>

    <SolidColorBrush x:Key="TextBrush"
                     Color="White"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush"
                     Color="#2D2D30"/>

    <SolidColorBrush x:Key="ControlForegroundBrush"
                     Color="White"/>

    <SolidColorBrush x:Key="GridBackgroundBrush"
                     Color="#252526"/>

    <SolidColorBrush x:Key="GridLineBrush"
                     Color="#555555"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background"
                Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background"
                Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Padding"
                Value="8,4"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"
                Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background"
                Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="Padding"
                Value="6"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background"
                Value="{DynamicResource GridBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="GridLinesVisibility"
                Value="All"/>
        <Setter Property="HorizontalGridLinesBrush"
                Value="{DynamicResource GridLineBrush}"/>
        <Setter Property="VerticalGridLinesBrush"
                Value="{DynamicResource GridLineBrush}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background"
                Value="{DynamicResource GridBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background"
                Value="{DynamicResource GridBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="BorderBrush"
                Value="{DynamicResource GridLineBrush}"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"
                Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground"
                Value="{DynamicResource ControlForegroundBrush}"/>
        <Setter Property="FontWeight"
                Value="Bold"/>
        <Setter Property="Padding"
                Value="6"/>
    </Style>

</ResourceDictionary>
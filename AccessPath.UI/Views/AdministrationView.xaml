<UserControl x:Class="AccessPath.UI.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AccessPath.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- PAGE HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Administration"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Review campus route reports and manage their status."
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- STATUS MANAGEMENT CARD -->

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel>

                    <TextBlock Text="Manage Report"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Select a report and update its review status."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,20"/>


                    <TextBlock Text="Report Status"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="ReportStatusComboBox"
                              Height="36"
                              Margin="0,6,0,20"/>


                    <Button x:Name="UpdateReportStatusButton"
                            Content="Update Status"
                            Height="38"
                            Click="UpdateReportStatusButton_Click"/>

                </StackPanel>

            </Border>


            <!-- ROUTE REPORTS CARD -->

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="Route Reports"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select a report to review or change its status."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <DataGrid x:Name="RouteReportsDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="RouteReportsDataGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding RouteReportType}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding RouteReportDescription}"
                                                Width="3*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding RouteReportStatus}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding RouteReportDate}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Route ID"
                                                Binding="{Binding RouteID}"
                                                Width="*"/>

                            <DataGridTextColumn Header="User ID"
                                                Binding="{Binding UserID}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>

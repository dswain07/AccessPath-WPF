<UserControl x:Class="AccessPath.UI.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AccessPath.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Routes"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Manage accessible routes between campus buildings."
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =================================================
                 ROUTE FORM
                 ================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Manage Route"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Add, update, or remove a campus route."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,20"/>


                        <!-- Start Building -->

                        <TextBlock Text="Start Building"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="StartBuildingComboBox"
                                  Height="36"
                                  Margin="0,6,0,14"/>


                        <!-- Destination Building -->

                        <TextBlock Text="Destination Building"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="DestinationBuildingComboBox"
                                  Height="36"
                                  Margin="0,6,0,14"/>


                        <!-- Minutes / Distance -->

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Estimated Minutes"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="EstimatedMinutesTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Distance"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="RouteDistanceTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>

                        </Grid>


                        <!-- Route Status -->

                        <TextBlock Text="Route Status"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="RouteStatusComboBox"
                                  Height="36"
                                  Margin="0,6,0,14"/>


                        <!-- Description -->

                        <TextBlock Text="Description"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="RouteDescriptionTextBox"
                                 Height="72"
                                 Margin="0,6,0,20"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>


                        <!-- CRUD Buttons -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Button Grid.Column="0"
                                    Content="Add"
                                    Height="38"
                                    Click="AddRouteButton_Click"/>

                            <Button Grid.Column="2"
                                    Content="Update"
                                    Height="38"
                                    Click="UpdateRouteButton_Click"/>

                            <Button Grid.Column="4"
                                    Content="Delete"
                                    Height="38"
                                    Click="DeleteRouteButton_Click"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- =================================================
                 ROUTE LIST
                 ================================================= -->

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- List Header -->

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="Campus Routes"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select a route to edit or delete it."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- Route Data -->

                    <DataGrid x:Name="RouteDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="RouteDataGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Minutes"
                                                Binding="{Binding EstimatedMinutes}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Distance"
                                                Binding="{Binding RouteDistance}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding RouteStatus}"
                                                Width="1.5*"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding RouteDescription}"
                                                Width="3*"/>

                            <DataGridTextColumn Header="Start ID"
                                                Binding="{Binding StartBuildingID}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Destination ID"
                                                Binding="{Binding DestinationBuildingID}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
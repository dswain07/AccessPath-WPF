<UserControl x:Class="AccessPath.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AccessPath.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Settings"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Customize your AccessPath experience."
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <!-- SETTINGS CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    VerticalAlignment="Top">

                <StackPanel>

                    <TextBlock Text="Appearance"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Choose how AccessPath looks while you use the application."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,22"/>

                    <TextBlock Text="Application Theme"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="ThemeComboBox"
                              Height="36"
                              Margin="0,6,0,20">

                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>

                    </ComboBox>

                    <Button Content="Apply Theme"
                            Height="38"
                            HorizontalAlignment="Left"
                            Width="140"
                            Click="ApplyThemeButton_Click"/>

                    <TextBlock Text="Theme changes are applied immediately. No restart is required."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,18,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
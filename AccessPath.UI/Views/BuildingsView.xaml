<UserControl x:Class="AccessPath.UI.Views.BuildingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AccessPath.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Buildings"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Manage and search campus building information."
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- =====================================================
             MAIN CONTENT
             ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- =================================================
                 MANAGE BUILDING CARD
                 ================================================= -->

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Manage Building"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Add, update, or remove a campus building."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,20"/>


                        <!-- Building Name -->

                        <TextBlock Text="Building Name"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="BuildingNameTextBox"
                                 Height="34"
                                 Margin="0,6,0,14"
                                 VerticalContentAlignment="Center"/>


                        <!-- Building Type -->

                        <TextBlock Text="Building Type"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="BuildingTypeTextBox"
                                 Height="34"
                                 Margin="0,6,0,14"
                                 VerticalContentAlignment="Center"/>


                        <!-- Opening / Closing Hours -->

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Opening Hours"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="OpeningHoursTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Closing Hours"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="ClosingHoursTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>

                        </Grid>


                        <!-- Latitude / Longitude -->

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Latitude"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="LatitudeTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Longitude"
                                           FontWeight="SemiBold"/>

                                <TextBox x:Name="LongitudeTextBox"
                                         Height="34"
                                         Margin="0,6,0,0"
                                         VerticalContentAlignment="Center"/>

                            </StackPanel>

                        </Grid>


                        <!-- Description -->

                        <TextBlock Text="Description"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="DescriptionTextBox"
                                 Height="72"
                                 Margin="0,6,0,14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>


                        <!-- Address -->

                        <TextBlock Text="Address"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="AddressComboBox"
                                  Height="36"
                                  Margin="0,6,0,20"/>


                        <!-- CRUD BUTTONS -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <Button x:Name="AddBuildingButton"
                                    Grid.Column="0"
                                    Content="Add"
                                    Height="38"
                                    Click="AddBuildingButton_Click"/>


                            <Button x:Name="UpdateBuildingButton"
                                    Grid.Column="2"
                                    Content="Update"
                                    Height="38"
                                    Click="UpdateBuildingButton_Click"/>


                            <Button x:Name="DeleteBuildingButton"
                                    Grid.Column="4"
                                    Content="Delete"
                                    Height="38"
                                    Click="DeleteBuildingButton_Click"/>

                        </Grid>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- =================================================
                 CAMPUS BUILDINGS CARD
                 ================================================= -->

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Card Heading -->

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="Campus Buildings"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Search or select a building to manage it."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- Search -->

                    <Grid Grid.Row="1"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>


                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="36"
                                 VerticalContentAlignment="Center"/>


                        <Button x:Name="SearchButton"
                                Grid.Column="2"
                                Content="Search"
                                Height="36"
                                Click="SearchButton_Click"/>

                    </Grid>


                    <!-- Building Data -->

                    <DataGrid x:Name="BuildingDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="BuildingDataGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Building"
                                                Binding="{Binding BuildingName}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding BuildingType}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Opening"
                                                Binding="{Binding OpeningHours}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Closing"
                                                Binding="{Binding ClosingHours}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding BuildingDescription}"
                                                Width="3*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>

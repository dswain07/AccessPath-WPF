<UserControl x:Class="AccessPath.UI.Views.AccessibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AccessPath.UI.Views"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource WindowBackgroundBrush}"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- PAGE HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Accessibility"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"/>

            <TextBlock Text="Manage accessibility features available in campus buildings."
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,4,0,0"/>

        </StackPanel>


        <!-- MAIN CONTENT -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ACCESSIBILITY FORM -->

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <StackPanel>

                    <TextBlock Text="Manage Accessibility"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <TextBlock Text="Add, update, or remove an accessibility feature."
                               FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="0,4,0,20"/>


                    <TextBlock Text="Building"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="BuildingComboBox"
                              Height="36"
                              Margin="0,6,0,14"/>


                    <TextBlock Text="Accessibility Feature"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="AccessibilityFeatureTextBox"
                             Height="34"
                             Margin="0,6,0,14"
                             VerticalContentAlignment="Center"/>


                    <TextBlock Text="Description"
                               FontWeight="SemiBold"/>

                    <TextBox x:Name="AccessibilityDescriptionTextBox"
                             Height="90"
                             Margin="0,6,0,20"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"/>


                    <!-- CRUD BUTTONS -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Add"
                                Height="38"
                                Click="AddAccessibilityButton_Click"/>

                        <Button Grid.Column="2"
                                Content="Update"
                                Height="38"
                                Click="UpdateAccessibilityButton_Click"/>

                        <Button Grid.Column="4"
                                Content="Delete"
                                Height="38"
                                Click="DeleteAccessibilityButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ACCESSIBILITY LIST -->

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,18">

                        <TextBlock Text="Building Accessibility Features"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select a feature to edit or delete it."
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <DataGrid x:Name="AccessibilityDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="AccessibilityDataGrid_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Feature"
                                                Binding="{Binding AccessibilityFeature}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding AccessibilityDescription}"
                                                Width="4*"/>

                            <DataGridTextColumn Header="Building ID"
                                                Binding="{Binding BuildingID}"
                                                Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>
<Window x:Class="AccessPath.UI.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccessPath.UI"
        mc:Ignorable="d"
        Title="AccessPath - Settings" Height="300" Width="450" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    
    <Grid Margin="30">

        <StackPanel>

            <TextBlock Text="Settings"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Application Theme"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="ThemeComboBox"
                      Width="200"
                      Height="30"
                      HorizontalAlignment="Left">

                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>

            </ComboBox>

            <Button Content="Apply Theme"
                    Width="120"
                    Height="30"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0"
                    Click="ApplyThemeButton_Click"/>

        </StackPanel>
        
    </Grid>
</Window>

<Window x:Class="AccessPath.UI.RouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccessPath.UI"
        mc:Ignorable="d"
        Title="AccessPath - Routes" Height="650" Width="1000" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock Text="Manage Routes"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Start Building"/>

            <ComboBox x:Name="StartBuildingComboBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <TextBlock Text="Destination Building"/>

            <ComboBox x:Name="DestinationBuildingComboBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <TextBlock Text="Estimated Minutes"/>

            <TextBox x:Name="EstimatedMinutesTextBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <TextBlock Text="Route Distance"/>

            <TextBox x:Name="RouteDistanceTextBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <TextBlock Text="Route Status"/>

            <ComboBox x:Name="RouteStatusComboBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <TextBlock Text="Description"/>

            <TextBox x:Name="RouteDescriptionTextBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      Margin="0,5"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,10,0,10">

                <Button Content="Add Route"
                        Width="110"
                        Margin="0,0,10,0"
                        Click="AddRouteButton_Click"/>

                <Button Content="Update Route"
                        Width="110"
                        Margin="0,0,10,0"
                        Click="UpdateRouteButton_Click"/>

                <Button Content="Delete Route"
                        Width="110"
                        Click="DeleteRouteButton_Click"/>

            </StackPanel>

            <DataGrid x:Name="RouteDataGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="RouteDataGrid_SelectionChanged"/>

        </StackPanel>
        
    </Grid>
</Window>
